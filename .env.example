# Public product configuration
NEXT_PUBLIC_APP_NAME=QuanticMail
NEXT_PUBLIC_MAIL_DOMAIN=quanticsillage.com

# JMAP discovery endpoint for the mail server.
# Local Stalwart example:
# http://localhost:8080/.well-known/jmap
# Production target:
JMAP_SESSION_URL=https://mail.quanticsillage.com/.well-known/jmap

# Required. Use a high-entropy value of at least 32 characters.
# Example generation command: openssl rand -base64 48
# Never commit the real value.
SESSION_SECRET=

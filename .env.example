# Public product configuration
NEXT_PUBLIC_APP_NAME=QuanticMail
NEXT_PUBLIC_MAIL_DOMAIN=sillage.com

# JMAP discovery endpoint for the mail server.
# Example for a Stalwart deployment:
# https://mail.example.com/.well-known/jmap
JMAP_SESSION_URL=

# Never commit real credentials. Authentication will be connected through
# the server-side session layer in the next milestone.
SESSION_SECRET=

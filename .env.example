# Public product configuration
NEXT_PUBLIC_APP_NAME=QuanticMail
# Example: quanticsillage.com
NEXT_PUBLIC_MAIL_DOMAIN=

# JMAP discovery endpoint for the optional Stalwart mail server.
# Local Stalwart example:
# http://localhost:8080/.well-known/jmap
# Production example:
# https://mx.example.com/.well-known/jmap
JMAP_SESSION_URL=

# Required for the current encrypted web session implementation.
# Example generation command: openssl rand -base64 48
SESSION_SECRET=

# Zero-cost inbound gateway through Resend.
# Never commit real values.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Optional durable signed identity checkpoint through GitHub.
# Use a fine-grained token restricted to the QuanticMail repository with
# Contents: Read and write. Never commit the real token.
QUANTIC_GITHUB_TOKEN=
QUANTIC_GITHUB_OWNER=XDSawyerLoL
QUANTIC_GITHUB_REPO=QuanticMail
QUANTIC_GITHUB_BRANCH=registry

# Standalone Quantic Relay / Discovery Mesh.
# QUANTIC_RELAY_BOOTSTRAP is a comma-separated list of relay origins.
# Bootstrap relays are peer entry points only; they are not identity authorities.
# Leave QUANTIC_RELAY_BOOTSTRAP empty for an isolated/private mesh.
QUANTIC_RELAY_HOST=127.0.0.1
QUANTIC_RELAY_PORT=8787
QUANTIC_RELAY_DATA_DIR=./data
QUANTIC_RELAY_BOOTSTRAP=

# Production Stalwart compose only (optional architecture).
# Example: mx.quanticsillage.com
MAIL_SERVER_HOSTNAME=

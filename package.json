{
  "name": "quanticmail",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "test": "node --experimental-transform-types --test tests/*.test.mjs tests/*.test.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "relay:start": "node --experimental-transform-types standalone-relay/main.ts",
    "relay:dev": "node --watch --experimental-transform-types standalone-relay/main.ts",
    "build:hostinger": "cross-env QUANTIC_STATIC_EXPORT=1 next build"
  },
  "dependencies": {
    "next": "16.3.3",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "typescript": "^5.9.0",
    "cross-env": "^10.0.0"
  }
}

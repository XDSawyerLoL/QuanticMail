{
  "name": "quanticmail",
  "version": "1.3.1",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "test": "node --experimental-transform-types --test tests/*.test.mjs tests/*.test.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "relay:start": "node --experimental-transform-types standalone-relay/main.ts",
    "relay:dev": "node --watch --experimental-transform-types standalone-relay/main.ts",
    "build:hostinger": "node scripts/build-hostinger-static.mjs",
    "relay:hostinger": "node --experimental-transform-types standalone-relay/hostinger-main.ts",
    "relay:smoke": "node scripts/smoke-hostinger-relay.mjs",
    "desktop:start": "electron .",
    "desktop:dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "next": "16.3.3",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.0.2",
    "mysql2": "^3.14.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "com.quanticsillage.quanticmail",
    "productName": "QuanticMail",
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "QuanticMail-Setup-${version}.${ext}",
      "icon": "desktop/assets/quantic-mail-mark.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QuanticMail"
    }
  },
  "engines": {
    "node": "22.x"
  }
}
